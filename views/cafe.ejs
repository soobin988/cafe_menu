<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴</title>
</head>
<body>
    <h1>카페 메뉴</h1>

    <form action="/" method="get">
        <label for="keyword">메뉴명</label>
        <input id="keyword" type="search" name="keyword" value="<%= keyword %>">
        <button type="submit">검색</button>
    </form>
    <form action="/menus/post" method="post">
        <input type="text" name="name" placeholder="메뉴명" maxlength="100" required>
        <input type="number" name="price" placeholder="가격"min="0" max="1000000" required>
        <input type="text" name="description" placeholder="설명" maxlength="200">
        <button type="submit">등록</button>
    </form>

    <table border="1">
        <thead>
            <tr>
                <th>번호</th>
                <th>메뉴명</th>
                <th>가격</th>
                <th>설명</th>
                <th>수정</th>
                <th>삭제</th>
            </tr>
        </thead>
        <tbody>
            <% menus.forEach(menu => { %>
                <tr>
                    <td><%= menu.id %></td>
                    <td><%= menu.name %></td>
                    <td><%= menu.price %>원</td>
                    <td><%= menu.description %></td>
                    <td>
                        <form action="/menus/edit" method="post">
                            <input type="hidden" name="id" value="<%=menu.id %>">
                            <input type="text" name="name" value="<%=menu.name %>" maxlength="100" required>
                            <input type="number" name="price" value="<%=menu.price %>" min="0" max="10000000" required>
                            <input type="text" name="description" value="<%=menu.description %>">
                            <button type="submit">수정</button>
                        </form>
                    <td>
                        <form action="/menus/delete" method="post">
                            <input type="hidden" name="id" value="<%= menu.id %>">
                            <button type="submit">삭제</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>